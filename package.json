{
  "name": "leki-mcp",
  "version": "0.1.0",
  "description": "MCP server for Polish medicines: official prices of refunded drugs, patient co-payment, cheaper substitutes, free drugs for 65+/children/pregnant, prescription status and leaflets. No API key.",
  "type": "module",
  "bin": {
    "leki-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "test": "npm run build && node --test test/unit.test.mjs",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "keywords": ["mcp", "model-context-protocol", "leki", "refundacja", "lista-lekow-refundowanych", "zamienniki", "apteka", "nfz", "medicines", "drug-prices", "poland", "open-data", "claude", "ai-agent"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/ContentWriterco/leki-mcp.git" },
  "homepage": "https://leki.compabase.com",
  "bugs": { "url": "https://github.com/ContentWriterco/leki-mcp/issues" },
  "mcpName": "io.github.ContentWriterco/leki-mcp"
}
